FROM qmcgaw/gluetun@sha256:5fc3a160f8ae25b229d974674b01b97bed3fe5a01a8e282911cfd1fffa8d383c

RUN apk add --no-cache jq curl ca-certificates tzdata \
    && mkdir -p /var/www /config/gluetun /run/secrets

COPY run.sh /run.sh
COPY landing.html.tpl /var/www/landing.html.tpl

RUN chmod +x /run.sh \
    && chmod 755 /var/www \
    && chmod 644 /var/www/landing.html.tpl \
    && chmod 700 /run/secrets

ENTRYPOINT ["/run.sh"]
